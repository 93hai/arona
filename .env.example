# Arona 3.0 COMPLETE CANDIDATE. Release gates: see RELEASE_STATUS.md.
# Linux paths; Windows development must use absolute drive paths.
# Loading this file is explicit: arona --env-file .env check-config
# Production: environment only, no .env. Provider keys are unnecessary for maintenance.
ARONA_ENV=development
ARONA_DATA_DIR=/var/lib/arona
ARONA_DB_PATH=/var/lib/arona/memory/arona_memory.db
ARONA_BACKUP_DIR=/var/lib/arona/backups
ARONA_CANDIDATE_DIR=/var/lib/arona/candidate
ARONA_STATE_DIR=/var/lib/arona/state
ARONA_LOG_DIR=/var/log/arona
ARONA_RUNTIME_SOURCE_DIR=/opt/arona/current
ARONA_LOG_LEVEL=INFO
ARONA_AUTO_MEMORY_ENABLED=false

# Core service: configure at least one provider (key + model + both token prices).
# Interaction allowlists do not authenticate a transport or expose a network service.
DISCORD_TOKEN=
ALLOWED_USER_IDS=
ALLOWED_CHANNEL_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=45
MISTRAL_API_KEY=
MISTRAL_GENERAL_MODEL=
MISTRAL_CODE_MODEL=
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_TIMEOUT_SECONDS=45

# Operator-supplied prices per million tokens, in the currency used by
# ARONA_DAILY_COST_BUDGET. Uncomment and fill BOTH values for each enabled model.
# There are no default prices: missing/invalid prices block provider startup.
# Use finite nonnegative numbers; set 0 only for an explicitly verified free rate.
# GEMINI_INPUT_COST_PER_MILLION=
# GEMINI_OUTPUT_COST_PER_MILLION=
# MISTRAL_INPUT_COST_PER_MILLION=
# MISTRAL_OUTPUT_COST_PER_MILLION=
# CODESTRAL_INPUT_COST_PER_MILLION=
# CODESTRAL_OUTPUT_COST_PER_MILLION=

ARONA_DAILY_TOKEN_BUDGET=100000
ARONA_DAILY_COST_BUDGET=100
ARONA_MAX_REQUEST_TOKENS=8000
ARONA_PROVIDER_FAILURE_THRESHOLD=3
ARONA_PROVIDER_COOLDOWN_SECONDS=300
ARONA_MEMORY_RECALL_LIMIT=5
ARONA_MEMORY_MIN_CONFIDENCE=0.7
# Default expiry applies only to Temporary Memory. Other types need explicit expiry.
ARONA_MEMORY_DEFAULT_TTL_SECONDS=2592000
